---
/**
 * A landing, v2 — composição tirada bloco a bloco da home da PLATFORM (docs/estudo-platform.md):
 * foto clara de ponta a ponta → faixa branca → carrossel de objetos → lista tipográfica →
 * promessas → perguntas → bloco-botão preto → rodapé de duas linhas.
 * Quase sem parágrafos: imagem, legenda e tipografia grande. O detalhe mora no FAQ.
 */
import Base from '@/layouts/Base.astro'
import {
  CATALOGO,
  CONTATO,
  CTA,
  CTA_APOIO,
  FAQ,
  OBJETOS,
  PARA_QUEM,
  PROMESSAS,
  SEO,
  urlCatalogo,
  urlWhatsapp,
} from '@/conteudo/site'
import { livros } from '@/lib/catalogo'

const base = import.meta.env.BASE_URL
const img = (p: string) => `${base}${p}`
const vitrine = await livros()
const wa = urlWhatsapp()

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${CONTATO.site}#editora`,
      name: CONTATO.editora,
      alternateName: 'Entend',
      url: CONTATO.site,
      email: CONTATO.email,
      telephone: '+55 85 99124-9368',
      sameAs: [CONTATO.instagram],
      address: {
        '@type': 'PostalAddress',
        streetAddress: CONTATO.rua,
        addressLocality: CONTATO.cidade,
        addressRegion: CONTATO.uf,
        postalCode: CONTATO.cep,
        addressCountry: 'BR',
      },
      description:
        'Editora para autores: acompanha de perto toda a trajetória de criação e lançamento de um livro, com vitrine e venda online.',
    },
    ...vitrine.map((l) => ({
      '@type': 'Book',
      name: l.titulo,
      ...(l.autor ? { author: { '@type': 'Person', name: l.autor } } : {}),
      publisher: { '@id': `${CONTATO.site}#editora` },
      offers: {
        '@type': 'Offer',
        price: l.preco.replace(/[^\d,]/g, '').replace(',', '.'),
        priceCurrency: 'BRL',
        availability: 'https://schema.org/InStock',
        url: CATALOGO,
      },
    })),
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
}
---

<Base titulo={SEO.titulo} descricao={SEO.descricao}>
  <link
    slot="cabeca"
    rel="preload"
    as="image"
    type="image/webp"
    href={img('img/hero.webp')}
    media="(min-width: 761px)"
    fetchpriority="high"
  />
  <link
    slot="cabeca"
    rel="preload"
    as="image"
    type="image/webp"
    href={img('img/hero-retrato.webp')}
    media="(max-width: 760px)"
    fetchpriority="high"
  />
  <script slot="cabeca" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav class="nav" aria-label="Principal">
    <a class="nav__marca" href={base}>ENTEND:</a>
    <div class="nav__links">
      <a href="#trajetoria">Trajetória</a>
      <a href="#para-quem">Para quem</a>
      <a href="#perguntas">Perguntas</a>
    </div>
    <a class="nav__cta" href={wa} data-wa data-local="nav">{CTA}</a>
  </nav>

  <main id="conteudo">
    <!-- 1. DOBRA — foto clara de ponta a ponta, título centralizado sobre ela. -->
    <section class="dobra" aria-labelledby="titulo-dobra">
      <picture class="dobra__foto">
        <source media="(max-width: 760px)" srcset={img('img/hero-retrato.webp')} />
        <img
          src={img('img/hero.webp')}
          width="2752"
          height="1536"
          fetchpriority="high"
          alt="Mesa de trabalho de um autor, com manuscritos e o livro CME, de Eliana de Goes, em pé sob a luz da janela."
        />
      </picture>
      <div class="dobra__texto">
        <h1 id="titulo-dobra">
          <span class="v-a">Para autores:<br />seu conhecimento merece virar livro</span>
          <span class="v-b">Para autores:<br />do manuscrito ao lançamento</span>
        </h1>
        <div class="dobra__pe">
          <p>
            A Entend acompanha você de perto, da primeira ideia ao lançamento — e seu livro chega à
            vitrine pronto para ser vendido.
          </p>
          <a class="seta seta--clara" href={wa} data-wa data-local="dobra">{CTA}</a>
          <span class="dobra__fio" aria-hidden="true"><span></span></span>
        </div>
      </div>
    </section>

    <!-- 2. FAIXA + CARROSSEL — cada etapa vira um objeto; o último é o livro real, à venda. -->
    <section aria-labelledby="titulo-trajetoria" id="trajetoria">
      <div class="faixa caixa">
        <h2 id="titulo-trajetoria" class="faixa__rotulo">Da ideia<br />à vitrine:</h2>
        <p class="faixa__frase">Seis objetos e um livro à venda: o caminho que a Entend faz com você.</p>
        <a class="seta" href={urlCatalogo('faixa_trajetoria')} data-catalogo data-local="faixa_trajetoria">Ver catálogo</a>
      </div>

      <div class="carrossel" data-carrossel>
        <ol class="carrossel__trilho" tabindex="0" aria-label="Etapas da trajetória, role para o lado">
          {
            OBJETOS.map((o) => (
              <li class="peca">
                <div class="peca__foto" style={`aspect-ratio:${o.proporcao}`}>
                  <img src={img(o.imagem)} alt="" loading="lazy" decoding="async" width="1200" height="1500" />
                </div>
                <div class="peca__legenda">
                  <p class="peca__autor">Etapa {o.etapa}</p>
                  <h3>{o.nome}</h3>
                  <p>{o.fase}</p>
                  <p class="peca__nota">{o.nota}</p>
                </div>
              </li>
            ))
          }
          {
            vitrine.map((l) => (
              <li class="peca peca--venda">
                <a class="peca__foto" style="aspect-ratio:3 / 4" href={urlCatalogo('peca')} data-catalogo data-local="peca">
                  <img
                    src={l.capaLocal ? img(l.capa) : l.capa}
                    alt={`Capa do livro ${l.titulo}${l.autor ? `, de ${l.autor}` : ''}`}
                    loading="lazy"
                    decoding="async"
                    width="1200"
                    height="1600"
                  />
                </a>
                <div class="peca__legenda">
                  <p class="peca__autor">{l.autor ?? 'Autor Entend'}</p>
                  <h3>{l.titulo}</h3>
                  <p>Etapa 07 — Lançamento e vitrine</p>
                  <p class="num">{l.preco}</p>
                  <a class="mini" href={urlCatalogo('peca_botao')} data-catalogo data-local="peca_botao">Ver no catálogo</a>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="carrossel__fio" aria-hidden="true"><span data-progresso></span></div>
      </div>
    </section>

    <!-- 3. LISTA TIPOGRÁFICA — como o calendário "SEASON ONE: AURA" da referência. -->
    <section class="lista" aria-labelledby="titulo-para-quem" id="para-quem">
      <h2 id="titulo-para-quem">Para quem sabe muito:</h2>
      <ul>
        {
          PARA_QUEM.map(([quem, situacao]) => (
            <li>
              <span>{quem}</span>
              <span>{situacao}</span>
            </li>
          ))
        }
      </ul>
      <p class="lista__fecho">
        Se você se viu numa dessas linhas, a conversa começa no WhatsApp.
        <a class="seta" href={wa} data-wa data-local="lista">{CTA}</a>
      </p>
    </section>

    <!-- 4. PROMESSAS — no lugar de uma garantia que não existe. -->
    <section aria-labelledby="titulo-promessas">
      <div class="faixa caixa">
        <h2 id="titulo-promessas" class="faixa__rotulo">O que<br />prometemos:</h2>
        <p class="faixa__frase">E o que ninguém honesto promete.</p>
        <a class="seta" href={wa} data-wa data-local="faixa_promessas">Conversar com a Entend</a>
      </div>
      <div class="promessas caixa">
        <ul>{PROMESSAS.sim.map((p) => <li>{p}</li>)}</ul>
        <ul class="promessas__nao">
          <li>Não prometemos best-seller.</li>
          <li>Não prometemos atalhos que pulam a edição.</li>
          <li>Não prometemos que o livro se escreve sozinho.</li>
        </ul>
      </div>
    </section>

    <!-- 5. PERGUNTAS — <details>: a resposta está no HTML mesmo fechada (Google e Ctrl+F). -->
    <section aria-labelledby="titulo-perguntas" id="perguntas">
      <div class="faixa caixa">
        <h2 id="titulo-perguntas" class="faixa__rotulo">Perguntas<br />de autores:</h2>
        <p class="faixa__frase">Antes de começar, o que mais nos perguntam.</p>
        <a class="seta" href={urlCatalogo('faixa_perguntas')} data-catalogo data-local="faixa_perguntas">Ver catálogo</a>
      </div>
      <div class="faq caixa">
        {
          FAQ.map(([pergunta, resposta], i) => (
            <details data-faq={i + 1}>
              <summary>{pergunta}</summary>
              <p>{resposta}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- 6. BLOCO-BOTÃO — o "EXPLORE THE ARCHIVE" da referência. -->
    <section class="bloco" aria-labelledby="titulo-bloco" data-fecho>
      <h2 id="titulo-bloco" class="so-leitor">Comece pelo WhatsApp</h2>
      <p class="bloco__antes">Não sabe se a sua ideia vira livro? Essa é a primeira pergunta que respondemos juntos.</p>
      <a class="bloco__botao" href={wa} data-wa data-local="fecho">{CTA}</a>
      <p class="bloco__depois">{CTA_APOIO}</p>
    </section>
  </main>

  <!-- 7. RODAPÉ — duas linhas, como a referência (WhatsApp no lugar da newsletter). -->
  <footer class="rodape caixa">
    <div class="rodape__linha">
      <p>A conversa editorial começa no WhatsApp — de onde você estiver.</p>
      <span class="rodape__campo num">WhatsApp: {CONTATO.telefone}</span>
      <a class="mini mini--grande" href={wa} data-wa data-local="rodape">Abrir conversa</a>
    </div>
    <div class="rodape__linha rodape__links">
      <div>
        <span>ENTEND:</span>
        <a href="#trajetoria">Trajetória</a>
        <a href="#perguntas">Perguntas</a>
        <a href={urlCatalogo('rodape')} data-catalogo data-local="rodape">Catálogo</a>
        <a href={CONTATO.site} rel="noopener">Escola Entend</a>
      </div>
      <div>
        <span>{CONTATO.endereco}</span>
        <a href={`mailto:${CONTATO.email}`}>{CONTATO.email}</a>
        <a href={CONTATO.instagram} rel="noopener">Instagram</a>
      </div>
    </div>
  </footer>

  <a class="barra-fixa" href={wa} data-wa data-local="barra_fixa" aria-hidden="true" tabindex="-1">
    {CTA} →
  </a>

  <script src="../scripts/pagina.ts"></script>
</Base>
